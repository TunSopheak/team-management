# Copy this file to `.env` and adjust. Never commit your real `.env`.

# ---- Server ----
# Port the Express server listens on (most hosts set this automatically).
PORT=3000
# Set to "production" when deployed (enables secure cookies and requires JWT_SECRET).
NODE_ENV=development

# Secret used to sign login tokens. REQUIRED in production: use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts, in days.
JWT_EXPIRES_IN_DAYS=7

# ---- Database ----
# PostgreSQL connection string (Neon, Supabase, Render, Railway, or your own server).
# Leave EMPTY for local development: an embedded PGlite database is stored in ./data/pglite.
DATABASE_URL=
# TLS for Postgres. Defaults to on in production; set to "false" for a local Postgres without TLS.
# DATABASE_SSL=false

# ---- Accounts ----
# The first account ever registered becomes the Super Admin.
# Set to "false" to stop open sign-ups; people added by an admin can still claim their accounts.
ALLOW_REGISTRATION=true
# Password given to demo accounts by `npm run db:seed`.
# SEED_PASSWORD=password123

# ---- Optional ----
# Only needed if the frontend is hosted on a different domain than the API (comma-separated).
# CORS_ORIGINS=https://my-frontend.example.com
# Login cookies are HTTPS-only in production. Set to "false" ONLY if you serve the app over plain HTTP.
# COOKIE_SECURE=false
# Frontend build-time setting: base URL of the API when it is on a different domain.
# VITE_API_URL=https://my-api.example.com
